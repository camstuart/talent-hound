# Task and application build output
/.task/
/bin/
/frontend/dist/
/frontend/node_modules/
/frontend/bindings/

# Generated desktop build assets
/build/darwin/Assets.car
/build/darwin/icons.icns
/build/windows/icon.ico
/build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
/wails_windows_*.syso

# Generated Linux packaging workspace
/build/linux/*.desktop
/build/linux/appimage/*
!/build/linux/appimage/build.sh

# Generated mobile build files
/build/ios/xcode/
/build/android/.gradle/
/build/android/.kotlin/
/build/android/build/
/build/android/app/build/
/build/android/app/src/main/jniLibs/
/build/android/local.properties
/build/android/overlay.json
/build/android/gen/

# Local SQLite data and sidecars
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Playwright
/frontend/.e2e-db/
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/

# Benchmark records from a real corpus. The invented corpus records into
# docs/product/benchmarks/ and is committed as evidence; a run against the
# recruiter's actual placements writes extracts from them, and those stay here.
/docs/product/benchmarks/private/

# OS junk
.DS_Store
Thumbs.db

# Local tooling config (Claude Code)
/.claude/

# Vendored Ollama binary staging folder (not committed; see docs/product/OLLAMA_BUNDLING.md)
build/ollama/*/

# MarkItDown sidecar build artifacts (pin is recorded in build/sidecar/PIN.md)
build/sidecar/dist/
build/sidecar/work/
build/sidecar/.venv/
build/sidecar/*.spec

# Compiled application binary (wails3 task build writes it here)
/talent-hound
